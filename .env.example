# ==============================================================================
# VisionPulse Configuration Template
# Copy to .env and adjust variables as needed for your local environment.
# NEVER commit your local .env with sensitive tokens or private configurations.
# ==============================================================================

# Core Application Settings
VISIONPULSE_APP_NAME="VisionPulse Studio"
VISIONPULSE_ENV="development"
VISIONPULSE_DEBUG=false
VISIONPULSE_LOG_LEVEL="INFO"

# Inference Device ('cpu', 'cuda', 'mps', or 'auto')
VISIONPULSE_DEVICE="auto"

# Model Selection
VISIONPULSE_YOLO_MODEL="yolov8n.pt"
VISIONPULSE_YOLO_CONF_THRESHOLD=0.35
VISIONPULSE_YOLO_IOU_THRESHOLD=0.45
VISIONPULSE_MOBILENET_TOP_K=5

# Video Stream Defaults
VISIONPULSE_CAMERA_INDEX=0
VISIONPULSE_FRAME_WIDTH=1280
VISIONPULSE_FRAME_HEIGHT=720
VISIONPULSE_FPS_TARGET=30

# API Server Settings
VISIONPULSE_API_HOST="127.0.0.1"
VISIONPULSE_API_PORT=8000

# Web UI Settings
VISIONPULSE_WEB_PORT=8501

# Export / Recording Directory
VISIONPULSE_EXPORT_DIR="./output"
